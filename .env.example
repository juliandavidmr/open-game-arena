# Supabase public configuration
# These NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Supabase server-only secrets
# Never expose these values to client components, logs, or analytics.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Postgres connection components
POSTGRES_DATABASE="postgres"
POSTGRES_HOST="your-pooler-host.supabase.com"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_USER="your-postgres-user"

# Postgres connection URLs
# Use POSTGRES_URL for application runtime connections through the pooler.
POSTGRES_URL="postgresql://user:password@pooler-host:6543/postgres?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@pooler-host:6543/postgres?pgbouncer=true&connect_timeout=15&sslmode=require"

# Required in Vercel Production. The build uses this direct, non-pooling URL
# to apply versioned Drizzle migrations before compiling the application.
POSTGRES_URL_NON_POOLING="postgresql://user:password@direct-host:5432/postgres?sslmode=require"

# Public canonical origin and server-side capability encryption secret
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
CAPABILITY_ENCRYPTION_KEY="replace-with-a-long-random-production-secret"
