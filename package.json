{
  "name": "arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then : \"${POSTGRES_URL_NON_POOLING:?POSTGRES_URL_NON_POOLING is required for production migrations}\" && bun run db:migrate; fi && next build",
    "start": "next start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "daisyui": "^5.7.22",
    "drizzle-orm": "^0.45.2",
    "gsap": "3.15.0",
    "i18next": "^26.4.0",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.5",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
